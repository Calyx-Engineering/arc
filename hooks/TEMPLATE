#!/usr/bin/env bash
# <hook-name> — <event> hook (matcher: <Tool|Tool>).
#
# <One paragraph: the friction this catches, and the mechanism it carries.>
#
# camp-reports: <event>, <event>
# checks: <check-name>, <check-name>
# skips: <check-name> (<condition>)
#
# The three lines above are the `camp-reports:` declaration. They are why this hook is
# visible when it fires — one declaration drives both the spoken report and the event-log
# entry. Name every check, including the ones that always pass: only reporting failures
# makes a silent hook indistinguishable from a working one.
# Format: docs/product-architecture/camp-reports.md
#
# Copy this file to start a new hook. Everything above `# ---- hook body ----` and
# everything below it is boilerplate that must not be removed: the kill switch, the
# fail-open wrapper and the declaration are what make a mistake here survivable and
# visible.

# ---- kill switch ----------------------------------------------------------------
# `bash hooks/hooks-off.sh <hook-name> 30` from any terminal in this repository mutes this one
# hook for thirty minutes and prints when it lapses. Per-hook, repo-scoped and expiring —
# `hooks/hooks-off.sh status` reads it back, `clear` ends it early. The escape hatch when a
# hook misbehaves: no editing JSON while the broken thing fights back, and nothing to remember
# beyond one command. #202.
. "${0%/*}/lib/hooks-off" 2>/dev/null && arc_hooks_off && exit 0

# ---- fail-open wrapper ----------------------------------------------------------
# Never `set -e`. A guardrail bug must never block every tool call. Deny only the one
# condition this hook was written to catch; on anything unexpected, exit 0 and allow.
set +e

INPUT="$(cat 2>/dev/null)"

# Emit a PreToolUse deny decision and exit. Only ever called from the one branch that
# has positively identified the condition being guarded against.
deny() {
  printf '%s' "{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":$(json_string "$1")}}"
  exit 0
}

# JSON-encode a string: escape backslash, quote, and newline. Enough for a reason field.
json_string() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | awk 'BEGIN{printf "\""} {printf "%s%s", sep, $0; sep="\\n"} END{printf "\""}'
}

# The three whitespace escapes `field` resolves. `printf -v` is a builtin, so the resolver
# below forks nothing — and a raw tab or carriage return sitting in this file would not
# survive an editor or a line-ending normalisation.
printf -v _ARC_NL  '\n'
printf -v _ARC_TAB '\t'
printf -v _ARC_CR  '\r'

# Read a top-level or nested field out of the hook payload without requiring jq.
# Usage: field file_path
#
# NOT `tr ',{}' | grep | sed`. That reader stood here until #300 and was wrong twice: it split
# the payload on commas, so a value carrying one arrived truncated at the comma; and when its
# `sed` could not parse the fragment it printed that fragment unchanged, so the caller was
# handed the key and its quotes back as if they were the value. Both are silent, and four
# hooks written from this skeleton inherited both. #230, #300.
#
# A JSON string ends at the first quote that is NOT escaped, so the scan counts the
# backslashes in front of each quote rather than stopping at the first one. The escapes `\"`,
# `\\`, `\n`, `\t` and `\r` are then resolved, because the resolved form is the one the caller
# acts on: a Windows `cwd` arrives with its separators doubled, and a multi-line command
# carries its line breaks as the two characters `\` and `n`.
#
# NO CLOSING QUOTE MEANS THE PAYLOAD WAS CUT OFF MID-VALUE. Yield nothing, never the rest —
# half a value is the shape a hook must be silent about rather than act on.
#
# Parameter expansion, no subprocess. The old form cost five processes on every tool call.
field() {
  local rest raw out chunk bs key="\"$1\""
  case "$INPUT" in *"$key"*) rest="${INPUT#*"$key"}" ;; *) return 0 ;; esac
  rest="${rest#*:}"
  while [ "${rest# }" != "$rest" ]; do rest="${rest# }"; done
  case "$rest" in '"'*) rest="${rest#\"}" ;; *) return 0 ;; esac

  raw=""
  while :; do
    case "$rest" in *'"'*) ;; *) return 0 ;; esac
    chunk="${rest%%\"*}"
    rest="${rest#"$chunk"\"}"
    # The backslash run immediately before the quote. An odd count escapes it.
    bs="${chunk##*[!\\]}"
    if [ $(( ${#bs} % 2 )) -eq 0 ]; then raw="$raw$chunk"; break; fi
    raw="$raw$chunk\""
  done

  out=""
  while [ -n "$raw" ]; do
    case "$raw" in *'\'*) ;; *) out="$out$raw"; break ;; esac
    chunk="${raw%%\\*}"
    out="$out$chunk"
    raw="${raw#"$chunk"\\}"
    case "$raw" in
      '"'*) out="$out\"";        raw="${raw#?}" ;;
      '\'*) out="$out\\";        raw="${raw#?}" ;;
      n*)   out="$out$_ARC_NL";  raw="${raw#?}" ;;
      t*)   out="$out$_ARC_TAB"; raw="${raw#?}" ;;
      r*)   out="$out$_ARC_CR";  raw="${raw#?}" ;;
      # Not an escape this reader resolves — a shell escape, a `\u`. Left as it is.
      *)    out="$out\\" ;;
    esac
  done
  printf '%s' "$out"
  return 0
}

# ---- hook body ------------------------------------------------------------------

# Every exit path that is not a positively-identified violation must `exit 0`.

exit 0
