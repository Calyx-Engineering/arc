#!/usr/bin/env bash
# handoff-archive — PreToolUse hook (matchers: Edit|Write|NotebookEdit, and Bash). Carries #152.
#
# `HANDOFF.md` is gitignored, so rewriting it destroys the state the session was given and
# leaves no copy anywhere. Same shape as replacing a diagram the user spent hours on instead
# of archiving it. This hook takes the copy first.
#
# camp-reports: handoff-archived
# checks: handoff-snapshot, user-authored-file-archived
# skips: handoff-snapshot (the payload names no session or no tool, there is no repository, or the root could not be read), user-authored-file-archived (the call names no file — a Bash call whose command matches none of the parsed overwrite forms, by design — the path lands outside the repository, it is the handoff itself, or the snapshot was already taken this session)
#
# WHAT GETS ARCHIVED: whatever git cannot restore. A tracked file needs no copy — git IS the
# copy, and archiving it would be duplicating the thing that already works. An untracked or
# ignored file has nothing behind it, so overwriting it is destruction. That rule is what
# generalises "the handoff" to #152's "any user-authored file" without needing a list.
#
# TWO MOMENTS, AND THEY ARE NOT THE SAME CHECK:
#
#   1. THE HANDOFF, AT THE SESSION'S FIRST TOOL CALL — of any kind, not the handoff's own. #152's
#      point is that a session which crashes never reaches write time, so a copy taken when
#      the handoff is rewritten is a copy taken too late. The snapshot is keyed to the
#      session id, so it happens once, before this session has written anything at all.
#
#   2. ANY OTHER USER-AUTHORED FILE, AS IT IS ABOUT TO BE REPLACED — because nothing can
#      know in advance which file that will be. Once per session per file: the first copy
#      holds what the USER wrote, and later ones would only hold this session's own edits.
#
# WHY IT IS ALSO ON THE Bash MATCHER. `cat > HANDOFF.md`, `mv`, `sed -i` and `rm` destroy a file
# without ever going through Edit or Write. Registered only on the edit tools, this hook would
# have missed every one of them — the handoff would be gone and no copy taken. Bash gets moment
# 1, the snapshot, unconditionally, which is what makes the cold-start property true whatever
# tool the session reaches for.
#
# MOMENT 2 ON Bash IS A WORD SPLIT OF THE COMMAND, NOT A SHELL PARSE — #351. `bash_overwrite_target`
# recognises four plain, single-command forms: a bare `>` redirect, `mv`, `rm`, `cp`. Anything
# that composes them — a pipeline, `&&`, a subshell, `sed -i`, a glued operator (`cat>file`), a
# quoted path with a space in it — is not parsed, because a wrong guess would copy the wrong
# file while reporting success. Named rather than implied away: those forms still destroy an
# untracked file with no copy kept.
#
# AND IT IS SILENT ON Bash — see `report()`. Speaking there would auto-approve the command.
#
# WHAT IT COSTS ON EVERY Bash CALL AFTER THE FIRST. Measured on this machine, 20 iterations,
# marker warm — which is the common case:
#
#   bash -c 'exit 0'        27 ms   the floor
#   hooks/mode-guard        65 ms   the other PreToolUse Bash hook
#   hooks/handoff-archive  147 ms
#
# Two earlier drafts of this comment were wrong about it. The first said "one file test"; the
# second, corrected to "tens of processes", then claimed that was "the floor for a hook on this
# matcher" — which the file next to it refutes, since mode-guard bails on a `case` before doing
# any of this. Review pass 4 measured it at 309 ms and called the claim out.
#
# The parse is now bash builtins rather than three `grep`/`sed` pipelines, which is what took it
# from 309 to 147. What remains is stdin, one `git rev-parse --git-dir` for the marker path, and
# one file test. Getting below that means not calling git, which means keying the marker
# somewhere other than the repository — a design change, not a tuning one.
#
# 147 ms on every Bash call in every repository the plugin is installed into is a real tax, and
# whether the Bash matcher is worth it is a judgement recorded on #152 rather than settled here.
#
# THIS IS THE PreToolUse PROXY FOR A COLD START, NOT A SessionStart HOOK. The property #152
# needs does hold — the handoff is copied before this session's first write of anything, so
# no rewrite of it can outrun the copy. A true SessionStart hook would also cover a session
# that reads, crashes, and never edits; that session destroyed nothing, so the gap is
# harmless. CLAUDE.md bars a SessionStart hook from being written autonomously, so the
# stronger form is a proposal, not this file.
#
# RECOVERY, NOT RECORD. The destination is `.arc-work/archive/`, which `.gitignore` already
# excludes — #152 requires the copy location be gitignored too. It is under the repo root
# rather than inside `.git/` so the user can find it; a recovery copy nobody can locate is
# not one. Nothing prunes it, and nothing should read it as history.
#
# IT ALSO LEAVES MARKERS IN `.git/`, and they are not pruned either. One per session for the
# handoff, plus one per file archived: `$GITDIR/arc-archive-<session>-<key>`. They are empty,
# they are what makes "once per session" true across separate hook invocations, and `.git/` is
# never committed — but a long-lived clone accumulates one per session forever. The same is true
# of `camp-session-start`'s marker, so this is the house pattern rather than a new one; it is
# named here because review pass 4 found it undocumented.

# ---- kill switch ----------------------------------------------------------------
# `bash hooks/hooks-off.sh handoff-archive 30` from any terminal in this repository mutes this one
# hook for thirty minutes and prints when it lapses. Per-hook, repo-scoped and expiring —
# `hooks/hooks-off.sh status` reads it back, `clear` ends it early. #202.
# Ahead of every other line, so a misbehaving copy can be silenced without editing JSON.
. "${0%/*}/lib/hooks-off" 2>/dev/null && arc_hooks_off && exit 0

# ---- the activation log ---------------------------------------------------------
# Sourced before anything can exit. This hook is SILENT on Bash by design — see `report()` —
# so on the matcher it runs most often it produces no visible trace at all, and the log is
# the only thing that says it ran. m44.
. "$(dirname "$0")/lib/activation-log" 2>/dev/null
arc_log_event handoff-archived

# A path taken before there is anything to weigh: both declared checks recorded as unrun,
# with the reason, and the hook leaves quietly.
nothing_to_weigh() {
  arc_log_skip handoff-snapshot "$1"
  arc_log_skip user-authored-file-archived "$1"
  arc_log_outcome ok "$1"
  exit 0
}

# ---- fail-open wrapper ----------------------------------------------------------
# Never `set -e`. This hook never denies at all — it copies and reports. On anything
# unexpected, exit 0 and allow: losing the archive is bad, blocking every edit is worse.
set +e

INPUT="$(cat 2>/dev/null)"

# Parsed with bash's own parameter expansion — NO subprocess at all.
#
# This hook runs on every Bash call in every repository the plugin is installed into, so the
# parse is the hot path. The previous form cost two processes per field (`grep` then `sed`, over
# a `tr` of the whole payload) and measured ~51 ms per field on Windows, three times over,
# before the hook had decided whether it had anything to do at all.
#
# Matching on the QUOTED key also fixes a bug rather than only being faster. The old `grep` was
# unanchored over the whole payload, and a Bash payload carries the command text — so
# `grep -n file_path hooks/handoff-archive`, run as a command, matched inside the command string
# and returned the command as a path.
#
# It finds `"<key>"`, expects a string value, and walks it to the closing quote. Tool payload
# paths and ids rarely carry one, but #351 reads `command` through this same function, and a
# quoted shell argument — `echo "note" > file`, `mv "a" b` — carries an ESCAPED `"` routinely.
# An earlier version stopped at the first `"`, escaped or not (`"${rest%%\"*}"`), which truncated
# `command` at that quote and silently dropped everything after it — the archive never ran.
# Character-scanned rather than another one-shot expansion, because unescaping `\"` and `\\` needs
# to look at what precedes each quote, not just find one. Still not a full JSON string: `\n`,
# `\t` and other escapes pass through with their backslash, which is fine for a path or a shell
# word and is not what this hook parses those for. The alternative remains a `jq` dependency for
# a hook on this matcher.
field() {  # field <key> — prints the string value of "<key>", or nothing
  local rest="${INPUT#*\"$1\"}"
  [ "$rest" = "$INPUT" ] && return 1          # key absent
  rest="${rest#*:}"
  while [ "${rest# }" != "$rest" ]; do rest="${rest# }"; done
  case "$rest" in '"'*) ;; *) return 1 ;; esac  # not a string value
  rest="${rest#\"}"
  local out="" c nc i=0 len=${#rest}
  while [ "$i" -lt "$len" ]; do
    c="${rest:$i:1}"
    if [ "$c" = '\' ]; then
      nc="${rest:$((i + 1)):1}"
      case "$nc" in
        '"') out="$out\"" ;;
        '\') out="$out\\" ;;
        *)   out="$out\\$nc" ;;
      esac
      i=$((i + 2))
      continue
    fi
    [ "$c" = '"' ] && break
    out="$out$c"
    i=$((i + 1))
  done
  printf '%s' "$out"
}

json_string() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | awk 'BEGIN{printf "\""} {printf "%s%s", sep, $0; sep="\\n"} END{printf "\""}'
}

# AND WHY IT IS SILENT ON Bash. `permissionDecision: "allow"` does not merely annotate the call —
# it APPROVES it, skipping the permission prompt. That is a defensible trade on the edit tools,
# where the decision is about a file this hook has just copied, and it is the shape the other
# hooks here use. It is not defensible on Bash: the first Bash call of a session would be
# auto-approved as a side effect of taking a handoff snapshot, and that call can be anything.
# So Bash gets the copy and no output at all — exit 0 with an empty stdout leaves the permission
# system exactly as it found it. Visibility is worth less than the prompt it would have skipped.
report() {
  arc_log_outcome_default repaired "took a copy before the overwrite"
  [ "$TOOL" = "Bash" ] && exit 0
  printf '%s' "{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"allow\",\"permissionDecisionReason\":$(json_string "$1")}}"
  exit 0
}

# A JSON string carries Windows separators escaped. Undo that, then work in forward slashes
# throughout — git reports its own paths that way on every platform.
# Guarded so a path with no backslash — every POSIX one, and so the whole fast path there —
# costs nothing. The substitution itself is left exactly as it was: an attempt to make it a bash
# builtin changed behaviour in a way this environment cannot check, so it was reverted rather
# than shipped on reasoning.
#
# NOTHING HERE COVERS THE BACKSLASH BRANCH. Every fixture path comes from `mktemp` and every
# path git reports on this machine uses forward slashes, so the selftests exercise only the
# `*)` arm above. That is a real gap, recorded on #152 rather than papered over: the branch that
# matters on Windows is the one no case runs.
unescape_path() {
  case "$1" in
    *\\*) printf '%s' "$1" | sed -e 's|\\\\|/|g' -e 's|\\|/|g' ;;
    *)    printf '%s' "$1" ;;
  esac
}

# strip_quotes <word> — a naive split leaves surrounding quotes on; drop one matched pair.
strip_quotes() {
  local w="$1"
  case "$w" in
    \"*\") w="${w#\"}"; w="${w%\"}" ;;
    \'*\') w="${w#\'}"; w="${w%\'}" ;;
  esac
  printf '%s' "$w"
}

# bash_overwrite_target <command> — prints the one path a plain `>`, `mv`, `rm` or `cp` would
# overwrite or destroy, or nothing. #351: these forms name no target the edit-tool matchers can
# see, so a Bash redirect over an untracked file destroyed it with no copy kept.
#
# A WORD SPLIT, NOT A SHELL PARSE. `read -ra` on the raw command text, same trade the rest of
# this hook makes: cheap, and wrong on a quoted path with a space in it or an operator glued to
# its word (`cat>file`, `mv a.txt||true`). Both are named gaps, not handled — getting them right
# needs a real parser, which this hot path cannot afford. A command this misreads either finds
# nothing (silent, same as today) or names the wrong path (archives something harmless) —
# never a deny, so the fail-open contract holds either way.
#
# `>>` (append) and `2>`/`&>` (a stream, not a file this hook can recover as text) are excluded
# on purpose — they are not the destructive overwrite #351 is about.
bash_overwrite_target() {
  local cmd="$1" words=() i n target="" ddidx=-1

  read -ra words <<<"$cmd" 2>/dev/null
  n=${#words[@]}
  [ "$n" -eq 0 ] && return 0

  for ((i = 0; i < n - 1; i++)); do
    case "${words[$i]}" in
      '>'|'1>') target="${words[$((i + 1))]}" ;;
    esac
  done
  if [ -n "$target" ]; then
    strip_quotes "$target"
    return 0
  fi

  # The last bare `--`, if any. A word after it is a literal argument regardless of a leading
  # dash — `rm -- -confidential.txt`, `mv -- foo -bar` are the standard idiom for a dash-named
  # file, and treating `-bar` as a flag there names the wrong file: the source, not the
  # destination whose content is actually lost.
  for ((i = 1; i < n; i++)); do
    [ "${words[$i]}" = "--" ] && ddidx=$i
  done

  case "${words[0]}" in
    mv|cp)
      # The last non-flag word is the destination — the one form that gets overwritten.
      for ((i = n - 1; i >= 1; i--)); do
        [ "$i" -eq "$ddidx" ] && continue
        if [ "$ddidx" -ge 1 ] && [ "$i" -gt "$ddidx" ]; then
          strip_quotes "${words[$i]}"
          return 0
        fi
        case "${words[$i]}" in -*) continue ;; esac
        strip_quotes "${words[$i]}"
        return 0
      done
      ;;
    rm)
      # The first non-flag word — one target per call, same as the other three forms.
      for ((i = 1; i < n; i++)); do
        [ "$i" -eq "$ddidx" ] && continue
        if [ "$ddidx" -ge 1 ] && [ "$i" -gt "$ddidx" ]; then
          strip_quotes "${words[$i]}"
          return 0
        fi
        case "${words[$i]}" in -*) continue ;; esac
        strip_quotes "${words[$i]}"
        return 0
      done
      ;;
  esac
  return 0
}

# ---- hook body ------------------------------------------------------------------

CWD="$(unescape_path "$(field cwd)")"
[ -d "$CWD" ] || CWD="$PWD"

# A truncated payload can still yield a readable `cwd`. Requiring the session id and the tool
# name as well means a half-written payload is silent rather than acting on a guess.
SESSION="$(field session_id)"
[ -n "$SESSION" ] || nothing_to_weigh "the payload names no session"
TOOL="$(field tool_name)"
[ -n "$TOOL" ] || nothing_to_weigh "the payload names no tool"
arc_log_event handoff-archived "tool=$TOOL"

# The file this call is about to replace, where the call names one.
#
# `field file_path` IS NOT READ FOR A Bash CALL, and that is a correctness fix rather than an
# optimisation. `field` is an unanchored grep over the whole payload, and a Bash payload carries
# the command text — so `grep -n file_path hooks/handoff-archive`, run as a command, made
# `field file_path` match inside the command string and return it as a path. Harmless in outcome,
# since no such file exists, but it defeated the fast path below and ran moment 2 on nonsense.
#
# A Bash call names a target through `bash_overwrite_target` instead — #351 — reading the
# `command` field itself rather than guessing at `file_path`.
TARGET=""
if [ "$TOOL" = "Bash" ]; then
  TARGET="$(unescape_path "$(bash_overwrite_target "$(field command)")")"
else
  TARGET="$(unescape_path "$(field file_path)")"
  [ -n "$TARGET" ] || TARGET="$(unescape_path "$(field notebook_path)")"
fi

GITDIR="$(git -C "$CWD" rev-parse --git-dir 2>/dev/null)"
[ -n "$GITDIR" ] || nothing_to_weigh "not a git repository"
case "$GITDIR" in /*|?:*) ;; *) GITDIR="$CWD/$GITDIR" ;; esac

# THE FAST PATH. Registered on the Bash matcher, this hook runs on every Bash call in the session.
# Once the snapshot has been CONSIDERED and there is no named file to weigh, there is nothing left
# to do.
#
# The marker it reads is written whether or not a copy was taken — see moment 1 below. An earlier
# version wrote it only inside `archive_file`, after that function's own early returns, so it
# existed only in a repository that HAD an untracked handoff. Every repo without one — which is
# every non-Arc repo the plugin is installed into — fell through the whole body on every Bash
# call, which is the opposite of what this path is for.
if [ -z "$TARGET" ] && [ -e "$GITDIR/arc-archive-$SESSION-handoff" ]; then
  arc_log_skip handoff-snapshot "already taken this session"
  arc_log_skip user-authored-file-archived "the call names no file"
  arc_log_outcome ok "the snapshot was already taken this session"
  exit 0
fi

ROOT="$(git -C "$CWD" rev-parse --show-toplevel 2>/dev/null)"
# No repo means no root to hang `.arc-work/` off, and no git to say what is tracked.
[ -n "$ROOT" ] || nothing_to_weigh "the repository root could not be read"
# Canonicalised through the shell, because git reports a path in its own form: under Git for
# Windows `/tmp/x` comes back as `C:/Users/.../Temp/x`. Comparing the two forms as strings makes
# every path look outside the repository, and the per-file archive silently never fires. The
# target below is reduced the same way so the two are comparable.
ROOT="$(cd "$ROOT" 2>/dev/null && pwd)" || nothing_to_weigh "the repository root could not be resolved"
[ -n "$ROOT" ] || nothing_to_weigh "the repository root could not be resolved"

STAMP="$(date -u +%Y%m%d-%H%M%S 2>/dev/null)"
[ -n "$STAMP" ] || STAMP=unstamped
ARCHIVE="$ROOT/.arc-work/archive"

ARCHIVED=""

# archive_file <absolute-path> <relative-path> <marker-key>
#
# Copies once per session per file. Returns 0 only when a copy was actually made, so the
# report names what happened rather than what was attempted.
archive_file() {
  local abs="$1" rel="$2" key="$3" marker dest size

  [ -f "$abs" ] || return 1

  # Never archive the archive. Without this, a session editing a recovered copy would fold
  # the store into itself on every edit.
  case "$rel" in .arc-work/archive/*) return 1 ;; esac

  # Tracked means git can restore it, so a copy here is duplication rather than recovery.
  git -C "$ROOT" ls-files --error-unmatch -- "$rel" >/dev/null 2>&1 && return 1

  marker="$GITDIR/arc-archive-$SESSION-$key"
  [ -e "$marker" ] && return 1

  # A cap, so a stray large untracked file cannot make every session pay a big copy. The
  # marker is written either way: skipped once is skipped for the session.
  size="$(wc -c < "$abs" 2>/dev/null)"
  : > "$marker" 2>/dev/null
  case "$size" in ''|*[!0-9]*) return 1 ;; esac
  [ "$size" -gt 5242880 ] && return 1

  dest="$ARCHIVE/$STAMP/$rel"
  mkdir -p "$(dirname "$dest")" 2>/dev/null || return 1
  cp -p "$abs" "$dest" 2>/dev/null || return 1
  return 0
}

# ---- 1 · the handoff, at this session's first call of any kind -------------------
# Deliberately not conditional on what is being edited. That is the whole difference between
# this and a copy taken at write time.
# A copy taken and nothing to copy are both the check having RUN — an archive is not a
# finding. The value says which, so the two are still distinguishable in the log.
if archive_file "$ROOT/HANDOFF.md" "HANDOFF.md" "handoff"; then
  arc_log_pass handoff-snapshot=archived
  ARCHIVED="$ARCHIVED
  - \`HANDOFF.md\` → \`.arc-work/archive/$STAMP/HANDOFF.md\` — taken before this session's first write, not before the handoff's"
fi

# The snapshot has now been CONSIDERED, whatever the answer was — no handoff, a tracked one, one
# too large, or one that was copied. The marker records that, so the fast path above is reached
# in a repository with no handoff at all and not only in one that had something to copy.
[ -n "$ARCHIVED" ] || arc_log_pass handoff-snapshot=nothing-to-copy
: > "$GITDIR/arc-archive-$SESSION-handoff" 2>/dev/null

# ---- 2 · and the file this call is about to replace, if git cannot restore it -----
# Only for a call that NAMES a file. An edit tool always does; a Bash call does only when
# `bash_overwrite_target` recognised one of its four plain forms — #351. A compound command
# (`sed -i`, `tee`, a here-doc, a pipeline) still names none, and what stays uncovered is
# named in the dev-log rather than implied to be handled.
if [ -z "$TARGET" ]; then
  arc_log_skip user-authored-file-archived "the call names no file"
fi
if [ -n "$TARGET" ]; then
  case "$TARGET" in
    /*|?:*) ABS="$TARGET" ;;
    *)      ABS="$CWD/$TARGET" ;;
  esac
  # Same reduction as ROOT above. The directory has to exist for `cd` to resolve it, which is
  # true whenever there is an existing file to archive — a brand-new file needs no copy.
  ABSDIR="$(cd "$(dirname "$ABS")" 2>/dev/null && pwd)"
  [ -n "$ABSDIR" ] && ABS="$ABSDIR/$(basename "$ABS")"
  REL="${ABS#"$ROOT"/}"
  # Outside the repo root, or a path that did not reduce — nothing sensible to file it under.
  if [ "$REL" = "$ABS" ]; then
    arc_log_skip user-authored-file-archived "the path lands outside the repository"
  elif [ "$REL" = "HANDOFF.md" ]; then
    arc_log_skip user-authored-file-archived "the file is the handoff, covered by the snapshot"
  else
    if archive_file "$ABS" "$REL" "$(printf '%s' "$REL" | cksum | cut -d' ' -f1)"; then
      arc_log_pass "user-authored-file-archived=$REL"
      ARCHIVED="$ARCHIVED
  - \`$REL\` → \`.arc-work/archive/$STAMP/$REL\` — untracked, so git could not have restored it"
    else
      arc_log_pass user-authored-file-archived=nothing-to-copy
    fi
  fi
fi

# `repaired`, not `ok`: a copy taken is neither a clean pass nor a finding — it is the hook
# having changed something to prevent a loss, which is what that word is in the set for.
[ -n "$ARCHIVED" ] && arc_log_outcome repaired "took a copy before the overwrite"
[ -n "$ARCHIVED" ] || arc_log_outcome ok "nothing needed a copy"

[ -n "$ARCHIVED" ] && report "**Camp here —** archived before overwriting.
  Checked: handoff snapshot, user-authored file archived$ARCHIVED
  Recovery only, gitignored, never pruned. Copy it back by hand if you need it."

exit 0
