#!/usr/bin/env bash
# branch-guard — PreToolUse hook (matcher: Edit|Write|NotebookEdit). Carries m10.
#
# Denies a source edit made on a coordination branch. The 08-03 incident — four weeks of
# hardware work landing on the wrong parent branch — cost a session to recover, and the
# same class of mistake recurred eight-plus times. CLAUDE.md said "check the branch first"
# and it was skipped, because advice with no trigger is not a mechanism.
#
# Coordination branches are `main`, `develop`, and any arc branch (`arc/<slug>`). An arc
# branch is where issue branches merge to; source work belongs on the issue branch nested
# under it. Docs and agent-facing files stay writable everywhere, because maintaining the
# record IS the coordination work those branches exist for.
#
# Three checks, m10's three. Branch kind is the one that maps to the session-costing 08-03
# failure; worktree identity catches an edit made in a window opened for something else, and
# base freshness catches a branch cut before other work merged. Each denies on its own
# condition only, and each is silent when it cannot classify what it is looking at.
#
# camp-reports: edit-denied
# checks: branch-kind, path-is-source, worktree-identity, base-freshness
# skips: branch-kind (there is no branch — no repository, a detached HEAD, or git is unavailable), path-is-source (the branch is not a coordination branch, or the payload names no file), worktree-identity (the path is relative, lands outside any repository, resolves to no directory that exists, this session is not in a repository, or there is no branch or file to check), base-freshness (not a work branch, the branch name carries no base, the base ref is absent, this base commit was already reported, the reminder could not be recorded, or there is no branch or file to check)

# ---- kill switch ----------------------------------------------------------------
# `touch ~/.claude/HOOKS_OFF` from any terminal makes every Arc hook inert.
[ -f "$HOME/.claude/HOOKS_OFF" ] && exit 0

# ---- the activation log ---------------------------------------------------------
# Sourced before anything can exit, so an entry lands whichever of this hook's exits is
# taken — and there are eight. m44.
. "$(dirname "$0")/lib/activation-log" 2>/dev/null
arc_log_event edit-checked

# ---- fail-open wrapper ----------------------------------------------------------
# Never `set -e`. A guardrail bug must never block every tool call.
set +e

INPUT="$(cat 2>/dev/null)"

json_string() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | awk 'BEGIN{printf "\""} {printf "%s%s", sep, $0; sep="\\n"} END{printf "\""}'
}

deny() {
  arc_log_outcome_default denied "the hook denied the edit"
  printf '%s' "{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":$(json_string "$1")}}"
  exit 0
}

field() {
  printf '%s' "$INPUT" | tr ',{}' '\n\n\n' | grep -m1 -- "\"$1\"" | sed 's/.*: *"\(.*\)"[^"]*$/\1/'
}

# ---- hook body ------------------------------------------------------------------

CWD="$(field cwd)"
[ -d "$CWD" ] || CWD="$PWD"

BRANCH="$(git -C "$CWD" rev-parse --abbrev-ref HEAD 2>/dev/null)"
# No branch means no repo, a detached HEAD, or git unavailable. Allow — the guard has
# nothing to say about work it cannot classify.
if [ -z "$BRANCH" ]; then
  for c in branch-kind path-is-source worktree-identity base-freshness; do
    arc_log_skip "$c" "no branch — no repository, a detached HEAD, or git is unavailable"
  done
  arc_log_outcome ok "no branch to classify"
  exit 0
fi

# Work branches nest under an arc by name, not by ref — git refs cannot nest under an
# existing branch — so `arc/02-foundation-issue-10-skeleton` is a *work* branch and
# `arc/02-foundation` is not. A numbered `-issue-` or `-pr-` segment is what tells them
# apart, and getting this backwards blocks work on the very branch the guard tells you to
# create: a direct PR's branch is `arc/04-dogfood-pr200-slug`, which carried no `-issue-`
# and so was read as coordination-only. It denied the fix to itself.
#
# The segment, not the prefix. `arc/` is this repo's; another repo's operating agreement
# names its own, and a work branch there must still be recognised. The `arc/*)` line below
# is the half that still hardcodes it — #203.
#
# Both bare forms are listed because a repo with no prefix at all names the branch
# `issue-42-slug`, which has nothing before the hyphen and misses `*-issue-*`. It would
# fall through to the topic-branch case and still be allowed, so this is classification
# rather than permission — but the fallback is what would have to stay permissive forever
# for that to keep being true, and a guard should not depend on its own catch-all.
case "$BRANCH" in
  main|master|develop)       KIND=trunk ;;
  *-issue-[0-9]*|issue-[0-9]*|*-pr[0-9]*|pr[0-9]*) KIND=work ;;   # an issue branch or a direct PR
  arc/*)                     KIND=arc ;;
  *)                         KIND=topic ;;
esac
arc_log_event edit-checked "branch=$BRANCH"
arc_log_pass "branch-kind=$KIND"

FILE="$(field file_path)"
if [ -z "$FILE" ]; then
  for c in path-is-source worktree-identity base-freshness; do
    arc_log_skip "$c" "the payload names no file"
  done
  arc_log_outcome ok "no file path to check"
  exit 0
fi

# Normalise separators so one set of patterns covers Windows and POSIX paths.
NORM="$(printf '%s' "$FILE" | tr '\\' '/')"

lower() { printf '%s' "$1" | tr 'A-Z' 'a-z'; }

# ---- check 1: branch kind -------------------------------------------------------
# Writable on a coordination branch: the record, the process, and the plugin's own
# agent-facing surface. This is what those branches exist to maintain.
if [ "$KIND" = trunk ] || [ "$KIND" = arc ]; then
  case "$NORM" in
    */docs/*|docs/*) arc_log_pass path-is-source=no ;;
    */.claude/*|.claude/*) arc_log_pass path-is-source=no ;;
    */.claude-plugin/*|.claude-plugin/*) arc_log_pass path-is-source=no ;;
    *.md) arc_log_pass path-is-source=no ;;
    */.gitignore|.gitignore) arc_log_pass path-is-source=no ;;
    *)
      arc_log_fail path-is-source=yes
      # Everything else on a coordination branch is source work.
      if [ "$KIND" = arc ]; then
        deny "Source edit blocked: you are on \`$BRANCH\`, an arc branch. Arc branches are coordination only — issue branches nest under them and merge back in. Create \`$BRANCH-issue-<N>-<slug>\` and edit there. (Markdown, docs/, .claude/ and .claude-plugin/ stay writable here — maintaining the record is what this branch is for.)"
      else
        deny "Source edit blocked: you are on \`$BRANCH\`. Work belongs on a branch — create one before the first edit. (Markdown, docs/, .claude/ and .claude-plugin/ stay writable here.)"
      fi
      ;;
  esac
else
  arc_log_skip path-is-source "the branch is not a coordination branch"
fi

# ---- check 2: worktree identity -------------------------------------------------
# A run gets a worktree of its own while another run works in the main tree, so an edit
# whose absolute path lands in a *different worktree of the same repository* is being made
# in someone else's window. `arc-loop.sh` opens those worktrees; the failure is a session
# reaching back into the tree it was moved out of.
#
# Same repository is the whole restriction, and it is what keeps this narrow. A different
# clone is a legitimate target — CLAUDE.md requires 04-arc-execution-and-roles.md to be
# edited in lodestar and arc in the same session — and a path in no repository at all
# (~/.claude/settings.json) is none of this hook's business. Both stay allowed. A relative
# path resolves against the session's own cwd, so it cannot land elsewhere.
WT_SKIP="the path is relative, so it resolves inside this worktree"
case "$NORM" in
  /*|[A-Za-z]:/*)
    WT_SKIP="the path lands outside any repository"
    TDIR="$(dirname "$NORM")"
    # A new file's directory may not exist yet. Walk up to the nearest one that does.
    while [ -n "$TDIR" ] && [ ! -d "$TDIR" ]; do
      TPARENT="$(dirname "$TDIR")"
      [ "$TPARENT" = "$TDIR" ] && break
      TDIR="$TPARENT"
    done
    # A path on a root that does not exist walks up to `.`, which is a directory — the
    # hook's own cwd, not the target's. Anything that stopped being absolute is unresolved.
    case "$TDIR" in /*|[A-Za-z]:/*|[A-Za-z]:) ;; *) TDIR= ;; esac
    if [ -z "$TDIR" ] || [ ! -d "$TDIR" ]; then
      WT_SKIP="the path resolves to no directory that exists"
    fi
    if [ -n "$TDIR" ] && [ -d "$TDIR" ]; then
      CWD_TOP="$(git -C "$CWD" rev-parse --show-toplevel 2>/dev/null)"
      TGT_TOP="$(git -C "$TDIR" rev-parse --show-toplevel 2>/dev/null)"
      if [ -n "$CWD_TOP" ] && [ -n "$TGT_TOP" ] && [ "$(lower "$CWD_TOP")" != "$(lower "$TGT_TOP")" ]; then
        # The common dir is the shared `.git` of a repository's worktrees. Equal means one
        # repository seen from two worktrees; unequal means two repositories, and those are
        # not this hook's business.
        CWD_COMMON="$(git -C "$CWD" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
        TGT_COMMON="$(git -C "$TDIR" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
        if [ -n "$CWD_COMMON" ] && [ "$(lower "$CWD_COMMON")" = "$(lower "$TGT_COMMON")" ]; then
          arc_log_fail worktree-identity=elsewhere
          arc_log_outcome denied "the file is in another worktree of this repository"
          deny "Edit blocked: \`$FILE\` is in \`$TGT_TOP\`, a different worktree of this repository. This session's worktree is \`$CWD_TOP\` — another run, or the orchestrator, is working in that one. Edit the copy under your own worktree, or open a session there."
        fi
      elif [ -n "$CWD_TOP" ] && [ -n "$TGT_TOP" ]; then
        WT_SKIP=""
      elif [ -z "$TGT_TOP" ]; then
        WT_SKIP="the path lands outside any repository"
      fi
      [ -n "$CWD_TOP" ] || WT_SKIP="this session is not in a repository"
    fi
    ;;
esac
if [ -n "$WT_SKIP" ]; then
  arc_log_skip worktree-identity "$WT_SKIP"
else
  arc_log_pass worktree-identity=own
fi

# ---- check 3: base freshness ----------------------------------------------------
# A work branch cut before other work merged carries a base that has moved on. The name
# gives the base away: `arc/04-dogfood-issue-161-slug` was cut from `arc/04-dogfood`.
BF_SKIP="the branch is not a work branch, so it names no base"
if [ "$KIND" = work ]; then
  BF_SKIP="the branch name carries no base"
  BASE="$(printf '%s' "$BRANCH" | sed -E 's/-(issue-[0-9]+|pr[0-9]+).*$//')"
  # No prefix before the segment (`issue-42-slug`) leaves the name unchanged — there is no
  # base to name, so there is nothing to compare.
  if [ -n "$BASE" ] && [ "$BASE" != "$BRANCH" ]; then
    BF_SKIP="the base ref is absent"
    # `origin/` first: what merged is a fact about the remote, and a local base ref can be
    # stale itself. Either way, an absent ref means silence.
    BASE_REF=
    for ref in "refs/remotes/origin/$BASE" "refs/heads/$BASE"; do
      if git -C "$CWD" rev-parse --verify -q "$ref" >/dev/null 2>&1; then BASE_REF="$ref"; break; fi
    done
    if [ -n "$BASE_REF" ]; then
      BF_SKIP=""
      BEHIND="$(git -C "$CWD" rev-list --count "HEAD..$BASE_REF" 2>/dev/null)"
      case "$BEHIND" in ''|*[!0-9]*) BEHIND=0 ;; esac
      if [ "$BEHIND" -gt 0 ]; then
        # Said once per base commit, not on every edit. m10 named the noise directly: firing
        # on every stale branch would be constant, and a guard nobody can work through gets
        # switched off. The stamp is keyed on the base's sha, so the next merge into the base
        # speaks up again.
        BASE_SHA="$(git -C "$CWD" rev-parse --short "$BASE_REF" 2>/dev/null)"
        GITDIR="$(git -C "$CWD" rev-parse --absolute-git-dir 2>/dev/null)"
        SLUG="$(printf '%s' "$BRANCH" | tr '/' '-')"
        STAMP="$GITDIR/arc-branch-guard/$SLUG-$BASE_SHA"
        if [ -n "$GITDIR" ] && [ ! -f "$STAMP" ]; then
          # Deny only once the reminder is recorded. A stamp that cannot be written would
          # otherwise deny the same edit forever, which is the dead session the fail-open
          # rule exists to prevent.
          if mkdir -p "$(dirname "$STAMP")" 2>/dev/null && : > "$STAMP" 2>/dev/null; then
            arc_log_fail base-freshness=behind-$BEHIND
            arc_log_outcome denied "the base is $BEHIND commit(s) ahead of this branch"
            deny "Base moved: \`$BASE_REF\` is $BEHIND commit(s) ahead of \`$BRANCH\`, so this branch was cut before that work merged. Run \`git merge $BASE_REF\` (or rebase) before continuing. Said once per base commit — repeat the edit to proceed without merging."
          else
            BF_SKIP="the reminder could not be recorded, so nothing was said"
          fi
        else
          BF_SKIP="this base commit was already reported"
        fi
      fi
    fi
  fi
fi
if [ -n "$BF_SKIP" ]; then
  arc_log_skip base-freshness "$BF_SKIP"
else
  arc_log_pass base-freshness=current
fi

exit 0
